{
  "name": "private-chat",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "description": "局域网端到端加密阅后即焚聊天（Tauri macOS / Windows 客户端 + 密文中继服务器）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "tauri dev",
    "app:build": "node scripts/bump.mjs patch && tauri build",
    "app:build:minor": "node scripts/bump.mjs minor && tauri build",
    "app:build:same": "tauri build",
    "version:bump": "node scripts/bump.mjs",
    "release": "node scripts/release.mjs",
    "server": "node server/index.js",
    "tauri": "tauri",
    "postinstall": "npm --prefix server install --no-audit --no-fund"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.8.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "vite": "^8.3.8"
  }
}
